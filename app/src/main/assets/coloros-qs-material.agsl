uniform float u_edgeReferenceAspect;
uniform shader uniBDFBitmap;
uniform int uEnableMetaBall;
uniform float2 u_size;
uniform float u_colorArray[20];
uniform float u_corner;
uniform float u_weight;
uniform float u_commonArray[8];
uniform int uEnableBlend;
uniform float3x3 uMatrix;
uniform float4 uMatrixParams;uniform float u_edgeArray[16];uniform float[16] u_shadowArray;const float EPS = 1e-6;
const float PI = 3.1415926;
const float ANTIALIASING = 1.5; struct CommonDataRect{
     float2 halfResolution;
     float2 pos;
     float2 halfSize;
     float coner;
     float weight;
};
struct ShapeResult {float sdf;float mix_c;};const float DEFAULT_TRANSITION_PIXELS = 4.0;
const float kAbs = 1.0;
const float rRef = 80.0;
const float kMax = 26.6;
const float junctionXBand = 70.0;
const float junctionYBand = 60.0;
const float junctionPower = 1.0;vec4 getColor(CommonDataRect rectData){
    vec4 resultColor = vec4(0.0);

    float type = u_colorArray[0];
    float numColor = u_colorArray[1];
    if(numColor <= 1.5){
        resultColor = vec4(u_colorArray[2], u_colorArray[3], u_colorArray[4], u_colorArray[5]);
        return resultColor;
    }

    vec2 halfSize = rectData.halfSize;
    vec2 u_size = halfSize*2.0;
    vec2 pos = rectData.pos;

    vec2 dir = vec2(1.0, 0.0);
    vec2 origin = vec2(0.0, 0.0);

    if(type < 0.5){
        dir = vec2(0.0, -u_size.y);
        origin = vec2(0.0, halfSize.y);
    }else if(type < 1.5){
        dir = vec2(-u_size.x, -u_size.y);
        origin = vec2(halfSize.x, halfSize.y);
    }else if(type < 2.5){
        dir = vec2(-u_size.x, 0.0);
        origin = vec2(halfSize.x, 0.0);
    }else if(type < 3.5){
        dir = vec2(-u_size.x, u_size.y);
        origin = vec2(halfSize.x, -halfSize.y);
    }else if(type < 4.5){
        dir = vec2(0.0, u_size.y);
        origin = vec2(0.0, -halfSize.y);
    }else if(type < 5.5){
        dir = vec2(u_size.x, u_size.y);
        origin = vec2(-halfSize.x, -halfSize.y);
    }else if(type < 6.5){
        dir = vec2(u_size.x, 0.0);
        origin = vec2(-halfSize.x, 0.0);
    }else if(type < 7.5){
        dir = vec2(u_size.x, -u_size.y);
        origin = vec2(-halfSize.x, halfSize.y);
    }

    float valueDot = dot(pos-origin, normalize(dir))/max(length(dir),0.001)*(numColor-1.0);
    vec4 col1 = vec4(u_colorArray[2], u_colorArray[3], u_colorArray[4], u_colorArray[5]);
    vec4 col2 = vec4(u_colorArray[6], u_colorArray[7], u_colorArray[8], u_colorArray[9]);
    vec4 col3 = vec4(u_colorArray[10], u_colorArray[11], u_colorArray[12], u_colorArray[13]);
    vec4 col4 = vec4(u_colorArray[14], u_colorArray[15], u_colorArray[16], u_colorArray[17]);
    if(valueDot<1.0){
        resultColor = mix(col1,col2,valueDot);
    }else if(valueDot<2.0){
        resultColor = mix(col2,col3,valueDot-1.0);
    }else{
        resultColor = mix(col3,col4,valueDot-2.0);
    }
    // resultColor = vec4(vec3(valueDot), 1.0);
    return resultColor;
}float random(float2 st) {
    return fract(sin(dot(st.yx,float2(79.1214,78.233)))*43760.5453);
}float softLight(float A,float B) {
    float l=B-(1.-2.*A)*B*(1.-B);
    float h=B+(2.*A-1.)*(sqrt(B)-B);
    return mix(l,h,step(.5,A));
}CommonDataRect getCommonDataRect(float2 coords) {
    CommonDataRect rectData;
    rectData.halfResolution = float2(u_commonArray[0], u_commonArray[1]);rectData.pos = coords.xy - float2(u_commonArray[2], u_commonArray[3]);
    rectData.halfSize = float2(u_commonArray[4], u_commonArray[5]);
    rectData.coner =  u_commonArray[6];
    rectData.weight = u_commonArray[7];return rectData;}
float smoothAbs(float x, float k) {
    return sqrt(x * x + k * k);
}
float smoothMaxSqrt(float a, float b, float k) {
    float d = a - b;
    return 0.5 * (a + b + sqrt(d * d + k * k));
}
float sdCapsule(float2 pLocal, float2 halfSize) {
    bool isVertical = halfSize.x < halfSize.y;
    float2 hs = isVertical ? halfSize.yx : halfSize;
    float2 pl = isVertical ? pLocal.yx : pLocal;

    float2 q = float2(smoothAbs(pl.x, kAbs), smoothAbs(pl.y, kAbs));
    float r = hs.y;
    float a = max(hs.x - r, 0.0);

    // float scale = r / max(rRef, 1e-3);
    float scale = r * 0.0125;
    float kMaxEff = kMax * scale;
    float xBandEff = junctionXBand * scale;
    float yBandEff = junctionYBand * scale;

    float s = q.x - a;
    float xHard = max(s, 0.0);
    float xSoft = (kMaxEff > 0.0) ? smoothMaxSqrt(s, 0.0, kMaxEff) : xHard;
    float wx = 1.0 - smoothstep(0.0, max(xBandEff, 1e-3), abs(s));
    float wy = smoothstep(r - max(yBandEff, 1e-3), r, q.y);
    // float w = pow(clamp(wx * wy, 0.0, 1.0), junctionPower);
    float w = clamp(wx * wy, 0.0, 1.0);
    float x = mix(xHard, xSoft, w);
    return length(float2(x, q.y)) - r;
}
float powFast(float x, float n) {
    // 保护极小值，防止 log2(0)
    x = max(x, 1e-8);
    return exp2(log2(x) * n);
}
float lpNorm(float2 v, float n) {
    v = abs(v);
    float m = max(v.x, v.y);
    if (m < 1e-8) return 0.0;
    float2 u = v / m;
    float s = powFast(u.x, n) + powFast(u.y, n);
    return m * exp2(log2(max(s, EPS)) / n);
}
float lpNorm4(float2 v) {
    v = abs(v);
    float2 v2 = v * v;
    float2 v4 = v2 * v2;
    return sqrt(sqrt(max(v4.x + v4.y, 0.0)));
}
float sdRoundRect(float2 p, float2 halfSize, float r, float n) {
    float2 q = abs(p) - halfSize + float2(r);
    float nClamped = max(n, 2.0);
    float dCorner = (abs(nClamped - 4.0) < 1e-3) ? lpNorm4(max(q, 0.0)) : lpNorm(max(q, 0.0), nClamped);
    if (q.x > 0.0 && q.y > 0.0) return dCorner - r;
    else return max(q.x, q.y) - r;
}
float smoothSDF_D(float2 p, float2 b, float corner, float weight){
    float rectSdf = 0.0;
    float d_corner_zone = 0.0;
    if (weight  < 2.0) {
        if(weight  > 1.005){
            float t = smoothstep(2.0, 1.0, weight);
            float d_G2 = sdRoundRect( p, b, corner, 2.0);
            float d_Capsule = sdCapsule( p, b);
            rectSdf = mix(d_G2, d_Capsule, t);
        }
        else
        {
            rectSdf = sdCapsule( p, b);
        }
    } else {
        rectSdf = sdRoundRect( p, b, corner, weight);
    }
    // 计算抗锯齿因子 (注意区间：从直线区走向圆角区)
    return rectSdf;
}float getDis(float2 pos,float2 halfsize) {
    float2 rect=abs(pos-halfsize);
    return rect.x+rect.y;
}half4 blendEdge(CommonDataRect rectData, half4 color, half4 rawColor, float d, float mix_c) {
    float3 uRectLineColor = float3(u_edgeArray[0], u_edgeArray[1], u_edgeArray[2]);
    float2 uRectLineNear = float2(u_edgeArray[3], u_edgeArray[4]);
    float2 uRectLineFar = float2(u_edgeArray[5], u_edgeArray[6]);
    float2 uRectLineAlpha = float2(u_edgeArray[7], u_edgeArray[8]);
    half4 uRectLineFade = half4(u_edgeArray[9], u_edgeArray[10], u_edgeArray[11], u_edgeArray[12]);
    float uAngle = u_edgeArray[13];
    float uRectLinePara1 = u_edgeArray[14];
    float uRectLinePara2 = u_edgeArray[15];
    float2 rectLineNear=uRectLineNear;
    float2 rectLineFar=uRectLineFar;
    half4 rectLineFade=uRectLineFade;
    if(d<-max(rectLineNear.y,rectLineFar.y)) {
        return color;
    }
    // Outer windows share the volume capsule's directional highlight distribution.
    // Keep the actual SDF and edge widths: only the lighting perimeter is normalized.
    float2 halfSize = rectData.halfSize;
    float2 edgePos = rectData.pos;
    if (u_edgeReferenceAspect > 0.0) {
        halfSize = float2(u_edgeReferenceAspect, 1.0);
        edgePos = rectData.pos / max(rectData.halfSize, float2(EPS)) * halfSize;
    }
    float distanceAll = (halfSize.x+halfSize.y)*2.0;
    float ratio = mod(uAngle+halfSize.x/distanceAll*0.5+0.5,1.0);
    float2 dir_pos= normalize(edgePos);
    float2 dirAbs_pos = abs(dir_pos);
    float2 pos_n = min(float2(dirAbs_pos.xy*halfSize.yx/max(float2(.001),dirAbs_pos.yx)),halfSize)*sign(dir_pos);
    float2 halfSize_symobol = float2(-halfSize.y,halfSize.x);
    float flag = mix(-1.0,1.0, step(ratio,0.5))*dot(halfSize_symobol,pos_n);
    float dis_point = distanceAll*min(ratio,1.0-ratio)*2.0;
    float dis_pos = getDis(pos_n,halfSize);
    float distance_near = mix(dis_point+dis_pos,abs(dis_point-dis_pos),step(0.,flag));
    distance_near=min(2.*distanceAll-distance_near,distance_near);
    float lineNearAlpha = uRectLineAlpha.x*smoothstep(rectLineFade.y*distanceAll, rectLineFade.x*distanceAll, distance_near);
    float lineFarAlpha = uRectLineAlpha.y*smoothstep(rectLineFade.w*distanceAll, rectLineFade.z*distanceAll, distanceAll-distance_near);
    float lineNearSdf=smoothstep(-rectLineNear.y,-rectLineNear.x,d);
    float lineFarSdf=smoothstep(-rectLineFar.y,-rectLineFar.x,d);
    if(uRectLinePara2 > EPS) {
        lineNearSdf = pow(lineNearSdf, uRectLinePara1)*uRectLinePara2+(1.0-uRectLinePara2)*lineNearSdf;
        lineFarSdf = pow(lineFarSdf, uRectLinePara1)*uRectLinePara2+(1.0-uRectLinePara2)*lineFarSdf;
    }
    lineNearAlpha*=lineNearSdf;
    lineFarAlpha*=lineFarSdf;
    float lineAlpha = clamp(lineNearAlpha+lineFarAlpha,0.,1.);    // 提亮亮度
    float gray = clamp(dot(float3(0.2126, 0.7152, 0.0722), rawColor.rgb)*1.2,0.0,1.0);
    //float edgeImprove = 0.1*pow((1.0 - gray), 4.0);
    float edgeImprove = (1.0 - gray);
    edgeImprove *= edgeImprove;
    edgeImprove *= edgeImprove;
    edgeImprove *= 0.1;
    half4 colorRGBA = clamp(rawColor+half4(float3(edgeImprove),0.0),0.0,1.0);
    colorRGBA.rgb = mix(2.0 * colorRGBA.rgb * uRectLineColor.rgb, 1.0 - 2.0 * (1.0 - colorRGBA.rgb) * (1.0 - uRectLineColor.rgb), step(uRectLineColor.rgb, float3(0.5)));
    return mix(color, colorRGBA, lineAlpha*mix_c);
}half4 blendShadowColor(float2 coords, CommonDataRect rectData, half4 color, float d, float mix_c) {
    float3 uFadeColor = float3(u_shadowArray[0], u_shadowArray[1], u_shadowArray[2]);
    float3 uFadeAlpha = float3(u_shadowArray[3], u_shadowArray[4], u_shadowArray[5]);
    float uFadeIn = u_shadowArray[6];
    float2 uFadeOffset = float2(u_shadowArray[7], u_shadowArray[8]);
    float2 uFadeScale = float2(u_shadowArray[9], u_shadowArray[10]);
    float uFadeInPara1 =  u_shadowArray[11];
    float uFadeInPara2 =  u_shadowArray[12];
    float uFadeOut = u_shadowArray[13];
    float uFadeOutPara1 =  u_shadowArray[14];
    float uFadeOutPara2 = u_shadowArray[15];
    float preCalcMinC = min(rectData.halfSize.x,rectData.halfSize.y);
    float2 fadeConer;
    fadeConer.y = min(preCalcMinC, max(uFadeOut*1.2, rectData.coner));
  
    float fadeAlpha = 0.0;
    float3 fadeAlphaVec3 = uFadeAlpha;
    float gray = clamp((dot(float3(0.2126, 0.7152, 0.0722), color.rgb) - 0.6) * 1.6, 0.0, 1.0);
    fadeAlphaVec3 =  fadeAlphaVec3*(1.0 - gray)*(1.0-gray);if(any(greaterThan(fadeAlphaVec3.xy, float2(EPS)))) {
    // FadeIn阴影坐标偏移
    float2 pos_new = (rectData.pos-uFadeOffset);
    float fadeLine = uFadeIn*-1.0;
    float fadeSdf = fadeLine;
    float2 halfSizeFade = rectData.halfSize*uFadeScale;
    fadeConer.x = min(min(halfSizeFade.x, halfSizeFade.y),max(uFadeIn*1.2,rectData.coner));
    // 仅对必要渐变区域进行sdf距离场进行计算
    if(rectData.weight<2.0 || any(greaterThanEqual(abs(pos_new), halfSizeFade - float2(fadeConer.x)))) {
        fadeSdf = smoothSDF_D(pos_new, halfSizeFade, fadeConer.x, rectData.weight);
        float alpha = smoothstep(fadeLine,0.0,fadeSdf)*smoothstep(fadeLine, 0.0, d);
        if(uFadeInPara2>EPS) {
            alpha = pow(alpha, uFadeInPara1)*uFadeInPara2+(1.0-uFadeInPara2)*alpha;
        }
        alpha = alpha*(fadeAlphaVec3.x-fadeAlphaVec3.y) + fadeAlphaVec3.y ;
        fadeAlpha = alpha;
    } else {
        fadeAlpha = fadeAlphaVec3.y;
    }
}if(fadeAlphaVec3.z>EPS) {
    float fadeLine =  uFadeOut *-1.0;
    float fadeSdf = fadeLine;
    // 仅对必要渐变区域进行sdf距离场进行计算
    if(rectData.weight<2.0 || any(greaterThanEqual(abs(rectData.pos), rectData.halfSize - float2(fadeConer.y)))) {
        // 如果能够复用描边距离场，不进行额外计算，直接复用
        if(abs(fadeConer.y - rectData.coner) < EPS) {
            fadeSdf = d;
        } else {
            fadeSdf = smoothSDF_D(rectData.pos, rectData.halfSize, fadeConer.y, rectData.weight);
        }
        float alpha = smoothstep(fadeLine,0.0,fadeSdf)*smoothstep(fadeLine, 0.0, d);
        if(uFadeOutPara2>EPS) {
            alpha = pow(alpha, uFadeOutPara1)*uFadeOutPara2+(1.0-uFadeOutPara2)*alpha;
        }
        alpha *= fadeAlphaVec3.z ;
        fadeAlpha = mix(fadeAlpha, 1.0,alpha);
        // fadeAlpha += alpha;
    }
}    // 内阴影噪点计算
    float2 uv_pos=coords.xy*0.013;
    float n=clamp((random(uv_pos)-.5)*0.008+.5,0.,1.);
    fadeAlpha=clamp(softLight(n,fadeAlpha),0.0,1.0);
    half4 fadeColor = half4(uFadeColor, fadeAlpha*mix_c);
    fadeColor.rgb = color.rgb+fadeColor.rgb;
    return half4(clamp(mix(color.rgb, fadeColor.rgb, fadeColor.a), 0.0,1.0),1.0);
}
half4 main(float2 position) {float2 matrixScale = max(float2(0.0000001), float2(uMatrixParams[0], uMatrixParams[1]));
float2 matrixTrans = float2(uMatrixParams[2], uMatrixParams[3]);
float2 mapCoords = (uMatrix * float3((position - matrixTrans) / matrixScale / matrixScale, 0.0)).xy;
half4 outputCol = half4(uniBDFBitmap.eval(mapCoords).rgb, 1.0);if (uEnableBlend != 0) {}half4 rawCol = outputCol;
float2 coords = float2(position.x, u_commonArray[1]*2.0-position.y);
CommonDataRect rectData = getCommonDataRect(coords);
half4 inputColor = getColor(rectData);
outputCol = mix(outputCol, half4(inputColor.rgb, 1.0), inputColor.a);float sdf = 1.0;
float mix_c = 1.0;sdf = smoothSDF_D(rectData.pos, rectData.halfSize, rectData.coner, rectData.weight);ShapeResult shapeResult = ShapeResult(sdf, mix_c);     float shape = smoothstep(0.0, -ANTIALIASING, shapeResult.sdf)*shapeResult.mix_c;
//     return half4((sin(shapeResult.sdf)+1.0)*0.5,shape,0.0,1.0);
     if(shape < EPS){
        return half4(0.0);
     }outputCol = blendEdge(rectData, outputCol, rawCol, shapeResult.sdf, 1.0);outputCol = blendShadowColor(coords, rectData, outputCol, shapeResult.sdf, 1.0);return outputCol*shape;}